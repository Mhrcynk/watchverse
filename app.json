{
  "expo": {
    "name": "WatchVerse",
    "slug": "watchverse",
    "version": "1.0.0",
    "scheme": "watchverse",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15171D",
    "primaryColor": "#E3262F",
    "description": "Sevdiğin film ve dizi evrenlerinde nerede kaldığını hatırla, sıradaki hikâyeni doğru sırayla bul.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mihracyanik.watchverse",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.mihracyanik.watchverse",
      "adaptiveIcon": {
        "backgroundColor": "#E3262F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15171D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
